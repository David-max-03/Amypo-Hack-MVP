# Copy to .env and adjust. Every backend setting can be overridden with an AMYPO_ variable
# (see backend/app/config.py).

# Ollama endpoint and model.
AMYPO_OLLAMA_HOST=http://localhost:11434
AMYPO_OLLAMA_MODEL=qwen2.5-coder:7b

# Concurrent generation requests. Only set above 1 when Ollama itself was started with
# OLLAMA_NUM_PARALLEL of at least this value, e.g.:  OLLAMA_NUM_PARALLEL=4 ollama serve
AMYPO_GENERATION_CONCURRENCY=1
